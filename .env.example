# =============================================================
# AuraPredict — Variables de entorno
# =============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# =============================================================

# ── Base de datos (PostgreSQL via Supabase) ───────────────────
# Connection string del Transaction Pooler de Supabase.
# Formato: postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Supabase Storage (Fase 2D) ────────────────────────────────
# URL del proyecto Supabase (sin trailing slash).
# Formato: https://XXXXXXXXXXXX.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service Role Key — acceso completo a la Storage REST API.
# Encuéntrala en: Supabase Dashboard → Project Settings → API → service_role key
# IMPORTANTE: esta clave tiene privilegios elevados.
#   - En Raspberry Pi: asegúrate de que .env tiene permisos 600 (chmod 600 .env)
#   - Nunca la expongas en logs ni en código fuente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.TU_SERVICE_ROLE_KEY_AQUI

# ── Seguridad / autenticación API ────────────────────────────
SECRET_KEY=tu_clave_secreta_para_jwt_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
