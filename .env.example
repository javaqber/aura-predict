# =============================================================
# AuraPredict — Variables de entorno
# NEVER commit the real .env to Git.
# Copy this file to .env and fill in the real values.
# =============================================================

# ── Base de datos (PostgreSQL via Supabase) ───────────────────
# Format: postgresql://postgres.XXXX:PASSWORD@host.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── Supabase Storage (Fase 2D — required for RAW/model sync) ──
# Project URL (no trailing slash)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service Role Key: Settings → API → service_role (keep secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.TU_SERVICE_ROLE_KEY_AQUI

# ── API Security ──────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Email Alerts (Gmail SMTP) ─────────────────────────────────
# Set EMAIL_ACTIVO=true to enable real email sending.
# Gmail: enable 2FA and use an App Password (not your account password).
EMAIL_ACTIVO=false
EMAIL_ORIGEN=aurapredict@gmail.com
EMAIL_CONTRASENA=TU_APP_PASSWORD_GMAIL
EMAIL_DESTINO=responsable@empresa.com

# ── Edge Scheduler ────────────────────────────────────────────
# Path to the machine YAML config file (overridden by --config flag)
MAQUINA_CONFIG=config/machines/example_cnc.yaml

# ── Logging ───────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
# LOG_FILE: optional path to write logs (leave empty for stdout only)
# LOG_FILE=/home/pi/aura-predict/logs/edge.log

# ── Environment ───────────────────────────────────────────────
# APP_ENV: development | production
# In development: warnings if using non-mock sensor type
# In production:  all features enabled, no dev warnings
APP_ENV=development
